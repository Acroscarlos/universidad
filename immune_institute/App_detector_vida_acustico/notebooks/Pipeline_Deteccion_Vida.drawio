    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD;\n    %% 1. Bases de Datos (Separadas) y Preprocesamiento Físico\n    DB1[\&quot;Dataset Zona Cero: Grabaciones manuales base. Asigna etiqueta Vida (1.0) o Ruido (0.0)\&quot;] --&gt; Unificacion;\n    \n    DB2[\&quot;Dataset Voces Español: Refuerzo de voz humana pura. Asigna etiqueta Vida (1.0) a todo\&quot;] --&gt; Unificacion;\n    \n    DB3[\&quot;Dataset ESC_50: Refuerzo de ruido ambiental bruto (Etiqueta 0.0)\&quot;] --&gt; FiltroAD21p;\n    FiltroAD21p[\&quot;Simulador Hardware AD21p: Aplica filtro pasa-bajos a 2500Hz y ruido estático\&quot;] --&gt; Unificacion;\n    \n    DB4[\&quot;Dataset UrbanSound8K: Refuerzo de ruido urbano bruto (Etiqueta 0.0)\&quot;] --&gt; FiltroUS8K;\n    FiltroUS8K[\&quot;Filtro de Metadatos CSV: Excluye clases vocales o musicales para evitar falsos negativos\&quot;] --&gt; Unificacion;\n\n    %% 2. Procesamiento DSP y DataLoaders\n    Unificacion[\&quot;Parseo y Balanceo: Unifica los datos y calcula el &#39;pos_weight&#39; para la clase minoritaria\&quot;] --&gt; Estandarizacion;\n    Estandarizacion[\&quot;Estandarización Temporal: Convierte a mono, remuestrea a 16kHz y hace recortes de 3s\&quot;] --&gt; ExtraccionMel;\n    ExtraccionMel[\&quot;Espectrograma Mel: Extrae 128 mels (150-7500Hz) y aplica normalización Min-Max\&quot;] --&gt; SplitData;\n    SplitData[\&quot;Generación DataLoaders: Divide en Train/Val (80/20) y empaqueta en lotes para GPU\&quot;] --&gt; RuidoGauss;\n\n    %% 3. Modelo y Entrenamiento\n    RuidoGauss[\&quot;Capa GaussianNoise: Inyecta estática aleatoria a los tensores para evitar Overfitting\&quot;] --&gt; ConvNet;\n    ConvNet[\&quot;Bloques CNN: 3 capas convolucionales sucesivas para extraer patrones espaciales\&quot;] --&gt; Clasificador;\n    Clasificador[\&quot;Clasificador Denso: Aplica Flattening, Dropout (0.5) y colapsa en 1 neurona lineal\&quot;] --&gt; LossOpt;\n    LossOpt[\&quot;Optimización y Métricas: Entrena con Adam y BCEWithLogitsLoss calculando el AUC\&quot;] --&gt; Exportacion;\n    Exportacion[\&quot;Exportación Táctica: Guarda exclusivamente los pesos en el archivo .pth\&quot;] --&gt; Barrido;\n\n    %% 4. Inferencia\n    Barrido[\&quot;Barrido Batch: Lee los archivos WAV extraídos de la memoria SD de campo\&quot;] --&gt; SlidingWindow;\n    SlidingWindow[\&quot;Ventanas Deslizantes: Segmenta audios largos en frames de 3s con solapamiento\&quot;] --&gt; Prediccion;\n    Prediccion[\&quot;Predicción Sigmoide: Genera la inferencia en modo evaluación y la pasa a porcentaje\&quot;] --&gt; FiltroCritico;\n    FiltroCritico[\&quot;Filtro Crítico: Evalúa si la probabilidad del tensor supera el 89%\&quot;] --&gt; Reporte;\n    Reporte[\&quot;Reporte Táctico: Muestra en consola el archivo y el rango de tiempo de la víctima\&quot;]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cCoYSpT8h5qtiREdj2Ff-76">
