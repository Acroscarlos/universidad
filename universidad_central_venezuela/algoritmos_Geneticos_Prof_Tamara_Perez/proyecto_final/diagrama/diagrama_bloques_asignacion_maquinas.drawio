        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Estilos visuales por componente del sistema electrico\n    classDef genA fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#000\n    classDef genB fill:#fff3e0,stroke:#ef6c00,stroke-width:1.5px,color:#000\n    classDef genC fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px,color:#000\n    classDef barra fill:#263238,stroke:#000000,stroke-width:3px,color:#fff\n    classDef linea fill:#ffebee,stroke:#c62828,stroke-width:2.5px,color:#000\n    classDef red fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2.5px,color:#000\n    classDef demanda fill:#fff9c4,stroke:#f9a825,stroke-width:2px,color:#000\n\n    %% ==========================================\n    %% NODO A (NODO 1): GENERACION BASE\n    %% ==========================================\n    subgraph Zona_A [\&quot;NODO A (Nodo 1): Área de Generación Base — Cap. Instalada: 2200 MW\&quot;]\n        direction TB\n        G1[\&quot;&lt;b&gt;G1&lt;/b&gt; (Vapor Carbón)&lt;br/&gt;Pmin: 100 MW | Pmax: 450 MW&lt;br/&gt;α=450, β=15.2, γ=0.0035 | Estado Ini: ON\&quot;]:::genA\n        G2[\&quot;&lt;b&gt;G2&lt;/b&gt; (Vapor Carbón)&lt;br/&gt;Pmin: 100 MW | Pmax: 450 MW&lt;br/&gt;α=420, β=15.5, γ=0.0038 | Estado Ini: ON\&quot;]:::genA\n        G3[\&quot;&lt;b&gt;G3&lt;/b&gt; (Vapor Carbón)&lt;br/&gt;Pmin: 80 MW | Pmax: 350 MW&lt;br/&gt;α=380, β=16.0, γ=0.0042 | Estado Ini: ON\&quot;]:::genA\n        G4[\&quot;&lt;b&gt;G4&lt;/b&gt; (Vapor Fuel Oil)&lt;br/&gt;Pmin: 80 MW | Pmax: 300 MW&lt;br/&gt;α=350, β=16.8, γ=0.0045 | Estado Ini: ON\&quot;]:::genA\n        G5[\&quot;&lt;b&gt;G5&lt;/b&gt; (Vapor Fuel Oil)&lt;br/&gt;Pmin: 60 MW | Pmax: 250 MW&lt;br/&gt;α=300, β=17.5, γ=0.0050 | Estado Ini: OFF\&quot;]:::genA\n        G6[\&quot;&lt;b&gt;G6&lt;/b&gt; (Ciclo Combinado)&lt;br/&gt;Pmin: 50 MW | Pmax: 200 MW&lt;br/&gt;α=250, β=18.2, γ=0.0060 | Estado Ini: OFF\&quot;]:::genA\n        G7[\&quot;&lt;b&gt;G7&lt;/b&gt; (Ciclo Combinado)&lt;br/&gt;Pmin: 50 MW | Pmax: 200 MW&lt;br/&gt;α=240, β=18.5, γ=0.0062 | Estado Ini: OFF\&quot;]:::genA\n\n        BarraA[\&quot;BARRA NODO A (1)&lt;br/&gt;Σ P_instalada = 2200 MW\&quot;]:::barra\n        DemA[\&quot;Demanda Local Nodo A:&lt;br/&gt;• Valle: 300 MW&lt;br/&gt;• Medio: 500 MW&lt;br/&gt;• Pico: 600 MW\&quot;]:::demanda\n\n        G1 &amp; G2 &amp; G3 &amp; G4 &amp; G5 &amp; G6 &amp; G7 --&gt; BarraA\n        BarraA --&gt; DemA\n    end\n\n    %% ==========================================\n    %% NODO B (NODO 2): GENERACION INTERMEDIA\n    %% ==========================================\n    subgraph Zona_B [\&quot;NODO B (Nodo 2): Área Mixta / Intermedia — Cap. Instalada: 1550 MW\&quot;]\n        direction TB\n        G8[\&quot;&lt;b&gt;G8&lt;/b&gt; (Ciclo Combinado)&lt;br/&gt;Pmin: 80 MW | Pmax: 350 MW&lt;br/&gt;α=360, β=19.0, γ=0.0055 | Estado Ini: OFF\&quot;]:::genB\n        G9[\&quot;&lt;b&gt;G9&lt;/b&gt; (Ciclo Combinado)&lt;br/&gt;Pmin: 80 MW | Pmax: 300 MW&lt;br/&gt;α=340, β=19.5, γ=0.0058 | Estado Ini: OFF\&quot;]:::genB\n        G10[\&quot;&lt;b&gt;G10&lt;/b&gt; (Ciclo Combinado)&lt;br/&gt;Pmin: 60 MW | Pmax: 250 MW&lt;br/&gt;α=280, β=20.0, γ=0.0065 | Estado Ini: OFF\&quot;]:::genB\n        G11[\&quot;&lt;b&gt;G11&lt;/b&gt; (Vapor Gas)&lt;br/&gt;Pmin: 50 MW | Pmax: 200 MW&lt;br/&gt;α=220, β=21.0, γ=0.0070 | Estado Ini: OFF\&quot;]:::genB\n        G12[\&quot;&lt;b&gt;G12&lt;/b&gt; (Vapor Gas)&lt;br/&gt;Pmin: 40 MW | Pmax: 180 MW&lt;br/&gt;α=200, β=21.8, γ=0.0075 | Estado Ini: OFF\&quot;]:::genB\n        G13[\&quot;&lt;b&gt;G13&lt;/b&gt; (Vapor Gas)&lt;br/&gt;Pmin: 30 MW | Pmax: 150 MW&lt;br/&gt;α=180, β=22.5, γ=0.0080 | Estado Ini: OFF\&quot;]:::genB\n        G14[\&quot;&lt;b&gt;G14&lt;/b&gt; (Vapor Gas)&lt;br/&gt;Pmin: 30 MW | Pmax: 120 MW&lt;br/&gt;α=150, β=23.2, γ=0.0085 | Estado Ini: OFF\&quot;]:::genB\n\n        BarraB[\&quot;BARRA NODO B (2)&lt;br/&gt;Σ P_instalada = 1550 MW\&quot;]:::barra\n        DemB[\&quot;Demanda Local Nodo B:&lt;br/&gt;• Valle: 500 MW&lt;br/&gt;• Medio: 850 MW&lt;br/&gt;• Pico: 1050 MW\&quot;]:::demanda\n\n        G8 &amp; G9 &amp; G10 &amp; G11 &amp; G12 &amp; G13 &amp; G14 --&gt; BarraB\n        BarraB --&gt; DemB\n    end\n\n    %% ==========================================\n    %% NODO C (NODO 3): GENERACION DE PICO\n    %% ==========================================\n    subgraph Zona_C [\&quot;NODO C (Nodo 3): Área de Carga y Pico Rápido — Cap. Instalada: 660 MW\&quot;]\n        direction TB\n        G15[\&quot;&lt;b&gt;G15&lt;/b&gt; (Turbina Gas Simple)&lt;br/&gt;Pmin: 40 MW | Pmax: 160 MW&lt;br/&gt;α=160, β=24.0, γ=0.0090 | Estado Ini: OFF\&quot;]:::genC\n        G16[\&quot;&lt;b&gt;G16&lt;/b&gt; (Turbina Gas Simple)&lt;br/&gt;Pmin: 30 MW | Pmax: 140 MW&lt;br/&gt;α=140, β=25.5, γ=0.0095 | Estado Ini: OFF\&quot;]:::genC\n        G17[\&quot;&lt;b&gt;G17&lt;/b&gt; (Turbina Gas Simple)&lt;br/&gt;Pmin: 25 MW | Pmax: 120 MW&lt;br/&gt;α=120, β=26.8, γ=0.0105 | Estado Ini: OFF\&quot;]:::genC\n        G18[\&quot;&lt;b&gt;G18&lt;/b&gt; (Turbina Gas Rápida)&lt;br/&gt;Pmin: 20 MW | Pmax: 100 MW&lt;br/&gt;α=100, β=28.0, γ=0.0115 | Estado Ini: OFF\&quot;]:::genC\n        G19[\&quot;&lt;b&gt;G19&lt;/b&gt; (Turbina Gas Rápida)&lt;br/&gt;Pmin: 20 MW | Pmax: 80 MW&lt;br/&gt;α=90, β=29.5, γ=0.0125 | Estado Ini: OFF\&quot;]:::genC\n        G20[\&quot;&lt;b&gt;G20&lt;/b&gt; (Turbina Gas Rápida)&lt;br/&gt;Pmin: 15 MW | Pmax: 60 MW&lt;br/&gt;α=80, β=31.0, γ=0.0135 | Estado Ini: OFF\&quot;]:::genC\n\n        BarraC[\&quot;BARRA NODO C (3)&lt;br/&gt;Σ P_instalada = 660 MW\&quot;]:::barra\n        DemC[\&quot;Demanda Local Nodo C:&lt;br/&gt;• Valle: 800 MW&lt;br/&gt;• Medio: 1250 MW&lt;br/&gt;• Pico: 1550 MW\&quot;]:::demanda\n\n        G15 &amp; G16 &amp; G17 &amp; G18 &amp; G19 &amp; G20 --&gt; BarraC\n        BarraC --&gt; DemC\n    end\n\n    %% ==========================================\n    %% LINEAS DE TRANSMISION Y LIMITES DE POTENCIA\n    %% ==========================================\n    LimA[\&quot;&lt;b&gt;LÍMITE DE TRANSMISIÓN / EVACUACIÓN NODO A&lt;/b&gt;&lt;br/&gt;P_nodo_A &lt;= &lt;b&gt;1500 MW&lt;/b&gt;&lt;br/&gt;(Retiene hasta 700 MW de máquinas baratas en congestión)\&quot;]:::linea\n    LimB[\&quot;&lt;b&gt;LÍMITE DE TRANSMISIÓN / EVACUACIÓN NODO B&lt;/b&gt;&lt;br/&gt;P_nodo_B &lt;= &lt;b&gt;1200 MW&lt;/b&gt;&lt;br/&gt;(Retiene hasta 350 MW cuando se satura)\&quot;]:::linea\n    LimC[\&quot;&lt;b&gt;LÍMITE DE TRANSMISIÓN / EVACUACIÓN NODO C&lt;/b&gt;&lt;br/&gt;P_nodo_C &lt;= &lt;b&gt;700 MW&lt;/b&gt;&lt;br/&gt;(Capacidad instalada = 660 MW, sin congestión interna)\&quot;]:::linea\n\n    BarraA ==&gt;|\&quot;Flujo P_A (λ_A)\&quot;| LimA\n    BarraB ==&gt;|\&quot;Flujo P_B (λ_B)\&quot;| LimB\n    BarraC ==&gt;|\&quot;Flujo P_C (λ_C)\&quot;| LimC\n\n    %% ==========================================\n    %% BALANCE DEL SISTEMA INTERCONECTADO\n    %% ==========================================\n    SIN[\&quot;&lt;b&gt;SISTEMA INTERCONECTADO NACIONAL (TRONCAL DE TRANSMISIÓN)&lt;/b&gt;&lt;br/&gt;Balance Horario: P_Nodo_A + P_Nodo_B + P_Nodo_C = P_Demanda_Total&lt;br/&gt;Capacidad Máxima Efectiva Evacuable = 1500 + 1200 + 660 = &lt;b&gt;3360 MW&lt;/b&gt;\&quot;]:::red\n\n    LimA &amp; LimB &amp; LimC ==&gt; SIN\n\n    subgraph Curva_Demanda [\&quot;Demanda Total del Sistema por Bloques (24 Horas)\&quot;]\n        direction LR\n        B1[\&quot;&lt;b&gt;BLOQUE 1: VALLE (00:00 - 08:00)&lt;/b&gt;&lt;br/&gt;Demanda Total = &lt;b&gt;1600 MW&lt;/b&gt;&lt;br/&gt;(300 + 500 + 800 MW)\&quot;]:::demanda\n        B2[\&quot;&lt;b&gt;BLOQUE 2: MEDIO (08:00 - 16:00)&lt;/b&gt;&lt;br/&gt;Demanda Total = &lt;b&gt;2600 MW&lt;/b&gt;&lt;br/&gt;(500 + 850 + 1250 MW)\&quot;]:::demanda\n        B3[\&quot;&lt;b&gt;BLOQUE 3: PICO (16:00 - 24:00)&lt;/b&gt;&lt;br/&gt;Demanda Total = &lt;b&gt;3200 MW&lt;/b&gt;&lt;br/&gt;(600 + 1050 + 1550 MW)\&quot;]:::demanda\n    end\n\n    SIN ==&gt; B1 &amp; B2 &amp; B3&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nVdm3WjJimfE6lhPiPdT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
